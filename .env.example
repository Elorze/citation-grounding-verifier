# OpenAI-compatible API key (DeepSeek, Zhipu, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
LLM_THINKING=disabled
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
PORT=3100
VERIFIER=optimized
EVAL_DELAY_MS=0

# Optional legacy alias if LLM_API_KEY is unset
# ZHIPU_API_KEY=
